# Скопируйте этот файл в .env.local и вставьте значения из Supabase → Project Settings → API.
# Без этих значений сайт работает в демо-режиме (данные в браузере).
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
# Адрес Edge Function с AI (если при создании в Supabase она получила другое имя)
VITE_AI_FUNCTION=ai
